# LLMesh agent (.env.agent) — operator-owned, gitignored.
#
# Tracked here as .env.agent.example so the deploy doc has a copy-paste
# starting point. Real values go to /opt/llmesh/app/.env.agent on the
# server (mode 600, owned by llmesh:llmesh).
#
# See decisions.md::D091 + docs/cicd_setup_circleci.md §1.14.

# ===== Hub auth =====
# API key the hub trusts when this agent registers. Must match an entry in
# /opt/llmesh/app/server_config.json on the hub side. Treat as a secret.
LLMESH_API_KEY=replace-with-real-hub-api-key

# ===== Hub target =====
# Local hub on this box (per D088, port 8003). Use https://<hub-host> if
# the agent is on a different machine fronting through nginx + Let's Encrypt.
HUB_URL=http://127.0.0.1:8003

# Operator label for this node (regex: ^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$,
# D048). Shows on the dashboard + in agent logs.
LLMESH_NODE_ID=mk4

# ===== Backend wiring (set the ones you actually run) =====

# Ollama — enabled by default if running on localhost:11434; no env needed.
# OLLAMA_NUM_CTX=8192

# vLLM — opt-in. Bearer auth (D014) via VLLM_API_KEY for hardened endpoints
# or LiteLLM Proxy. VLLM_HEALTH_PATH=/health/liveliness for LiteLLM.
# VLLM_HOST=http://127.0.0.1:4000
# VLLM_API_KEY=replace-with-real-vllm-bearer-token
# VLLM_STREAMING_ENABLED=true
# VLLM_MAX_CONTEXT=32000

# MLX (Apple Silicon — osaurus or mlx-lm.server). Linux deploys leave unset.
# MLX_HOST=http://localhost:1337

# ===== Stream batcher tunables (D041) =====
# Pin batch size for load tests; leave unset for adaptive auto-tune.
# STREAM_BATCH_FIXED=1

# LLAMACPP_HOST=http://127.0.0.1:8080
# LLAMACPP_API_KEY=          # only if llama-server started with --api-key