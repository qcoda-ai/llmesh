#!/usr/bin/env bash
# pre-commit hook — Ledger Law (BLOCKING per D065) + secrets scan (blocking).
# Installed via: bash scripts/install_git_hooks.sh
# Source of truth: scripts/git_hooks/pre-commit (versioned).

set -e

# 1. Ledger Law — BLOCKING per D065 (2026-05-28).
#    Was warn-only during D042 first-week rollout; flipped to blocking after
#    no false-positive incidents observed across the rollout window. To revert
#    temporarily for an emergency commit: pass `--no-verify` to git commit and
#    open a follow-up decision explaining the bypass.
if ! python scripts/validate_decisions.py; then
    echo ""
    echo "─────────────────────────────────────────────────────"
    echo "  ❌ pre-commit BLOCKED — Ledger Law violation"
    echo "─────────────────────────────────────────────────────"
    echo ""
    echo "  Resolve the OPEN decision or doc-coverage gap, re-stage, and retry."
    echo "  Emergency bypass: git commit --no-verify (open a follow-up decision)."
    echo ""
    exit 1
fi

# 2. Secrets scan — gitleaks against staged changes (always blocking).
if ! command -v gitleaks >/dev/null 2>&1; then
    echo ""
    echo "─────────────────────────────────────────────────────"
    echo "  ❌ pre-commit BLOCKED — gitleaks not installed"
    echo "─────────────────────────────────────────────────────"
    echo ""
    echo "  Install on macOS:    brew install gitleaks"
    echo "  Install elsewhere:   https://github.com/gitleaks/gitleaks#installing"
    echo ""
    echo "  Bypass (only if you know the diff is clean):"
    echo "    git commit --no-verify ..."
    echo ""
    exit 1
fi

GITLEAKS_OUT=$(mktemp)
trap 'rm -f "$GITLEAKS_OUT"' EXIT
if ! gitleaks protect --staged --redact --no-banner --config .gitleaks.toml >"$GITLEAKS_OUT" 2>&1; then
    echo ""
    echo "─────────────────────────────────────────────────────"
    echo "  ❌ pre-commit BLOCKED — gitleaks found a secret"
    echo "─────────────────────────────────────────────────────"
    echo ""
    cat "$GITLEAKS_OUT"
    echo ""
    echo "  Remove the secret, rotate the credential if it was real,"
    echo "  and re-stage. If the hit is a known-safe fixture, add it"
    echo "  to .gitleaks.toml [allowlist] paths or fingerprints."
    echo ""
    exit 1
fi
