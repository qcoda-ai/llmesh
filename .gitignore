# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Config files containing secrets
api_keys.json
server_config.json
# Allow the committed test fixture (contains no real secrets)
!tests/fixtures/server_config.json

# C extensions
*.so

