.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Logs
*.log
logs/

# Database
*.db
*.db-wal
*.db-shm
*.sqlite3

# OS
.DS_Store
Thumbs.db

# Alembic
alembic/versions/*.pyc
.aider*

# Local deployment templates with operator-specific values (D016)
# Track only the *.example versions; the populated copies stay local.
nodeclient.service
llmesh.service
llmesh-nginx.conf
!*.example

# Lab run artefacts — operator-generated trend data, not source.
# Track only `.gitkeep` so directory persists.
.qcoda/labs/*/runs/*.json
!.qcoda/labs/*/runs/.gitkeep
