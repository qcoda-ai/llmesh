# LLMesh Hub — Environment Configuration
# Copy this file to .env and edit as needed.
# API keys are configured in server_config.json, not here.

# ── Agent backends ───────────────────────────────────────────────────────────
# These vars are read by lib/agent/client.py — set them on agent nodes, not
# on the hub. Each backend is opt-in: leave the *_HOST var unset to disable
# detection of that backend entirely.

# Optional human-readable node ID. Default: auto-generated salted-hash
# fingerprint ("node_<16hex>"). Set this to a hostname or label to make
# logs / dashboard / URL paths identify the machine. Must match
# `[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}` — alphanumeric with `_`, `.`, `-`,
# max 64 chars, leading char alphanumeric. Operator owns collision
# avoidance: setting the same value on two agents causes the second to
# inherit the first's token. See decisions.md D048.
# LLMESH_NODE_ID=gpu-host-1

# Ollama context window (used in chat/generate request options)
OLLAMA_NUM_CTX=38000 # change it to what you think you need

# vLLM (or any OpenAI-compatible endpoint — e.g. LiteLLM Proxy)
# VLLM_HOST=http://127.0.0.1:8001
#
# Optional bearer token for auth-protected vLLM-compatible endpoints. Plain
# local vLLM does not need this; LiteLLM Proxy and hardened reverse proxies
# do. See docs/integrations/litellm.md.
# VLLM_API_KEY=sk-replace-me
#
# Path the agent probes for vLLM liveness. Default `/health` works for
# vanilla vLLM. LiteLLM users should set this to `/health/liveliness` —
# LiteLLM's `/health` runs a real upstream model probe and is too heavy
# for a 2-second liveness check.
# VLLM_HEALTH_PATH=/health
#
# Optional explicit context-window override for the vLLM backend. By
# default the agent auto-detects this from `max_model_len` in vLLM's
# `/v1/models` response (vLLM exposes it as a non-standard extension
# field on each model card). Set this when running behind a proxy that
# strips the field — e.g. some LiteLLM configurations — or to clamp
# the advertised window below the model's actual capability for
# routing purposes. See decisions.md D015.
# VLLM_MAX_CONTEXT=32768
#
# Master gate for vLLM real per-token streaming (D040, default flipped to ON
# in D044 after operator verification on real hardware). Set to "false" to
# fall back to the blocking + D018 bridge path (single-frame SSE delivery).
# VLLM_STREAMING_ENABLED=true

# MLX (Apple Silicon)
# MLX_HOST=http://127.0.0.1:1337

# ── Session storage ──────────────────────────────────────────────────────────
#
# Bare-metal / local default: SQLite (no extra services required).
# Docker default: Postgres — set automatically by docker-compose.yml environment block.
# You do not need to change these values when using Docker.

# Backend: "sqlite" (default for bare-metal) or "postgres"
SESSION_BACKEND=sqlite

# SQLite database path (only used when SESSION_BACKEND=sqlite)
# In Docker this is set to /data/sessions.db via the named volume.
# SESSION_DB=/data/sessions.db

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# REQUIRED when running via docker-compose.yml. docker compose will refuse to
# start if these are unset. Choose a strong password — these are the credentials
# for the Postgres container that backs session storage.
POSTGRES_DB=llmesh
POSTGRES_USER=llmesh
POSTGRES_PASSWORD=change-me-strong-password
#
# For bare-metal Postgres (no docker compose), set DATABASE_URL directly and
# ignore the POSTGRES_* vars above.
# DATABASE_URL=postgresql://user:password@localhost:5432/llmesh

# Session lifetime in seconds (default: 7200 = 2 hours)
SESSION_TTL_SECONDS=7200

# Number of conversation turns before compression triggers (default: 20)
SESSION_MAX_TURNS=20

# Compression strategy: "cutoff" | "balanced" | "aggressive"
#   cutoff     — drop oldest messages, no model required (default for Docker)
#   balanced   — summarise older half, keep newer half verbatim
#   aggressive — summarise everything except the last 2 turns
SESSION_MEMORY_MODE=cutoff

# ── Session compression model ────────────────────────────────────────────────
# Only applies when SESSION_MEMORY_MODE is "balanced" or "aggressive".
# The model is downloaded from HuggingFace on first startup (~300 MB).

# COMPRESS_MODEL_REPO=Qwen/Qwen2.5-0.5B-Instruct-GGUF
# COMPRESS_MODEL_FILE=qwen2.5-0.5b-instruct-q4_k_m.gguf
# COMPRESS_MODEL_CTX=4096
# COMPRESS_N_THREADS=4

# ── Task lifecycle ───────────────────────────────────────────────────────────

# Seconds before completed/failed tasks are purged from the in-memory store (default: 3600 = 1 hour)
# TASK_TTL_SECONDS=3600

# Seconds the SSE generator waits for the next token chunk before declaring the node dead (default: 30)
# STREAM_CHUNK_TIMEOUT=30

# ── Stream batching (agent → hub) ────────────────────────────────────────────
# Read by lib/agent/streaming_batcher.py. Adaptive token batching caps POST
# rate to the hub /stream endpoint under fast backends (vLLM 50-200 tok/s).
# All values optional — defaults give sensible behavior. See decisions.md D041.
#
# Starting batch size for adaptive mode (default: 10)
# STREAM_BATCH_INITIAL=10
#
# Latency cap in milliseconds — forces flush even if batch size not reached (default: 100)
# STREAM_BATCH_TIME_MS=100
#
# Target POST rate per second; adaptive math aims here (default: 10)
# STREAM_BATCH_TARGET_PPS=10
#
# Adaptive floor / ceiling on batch size (defaults: 1, 100)
# STREAM_BATCH_MIN=1
# STREAM_BATCH_MAX=100
#
# Hard memory cap; task aborts if exceeded (default: 1000)
# STREAM_BATCH_MAX_BUFFER=1000
#
# Operator escape hatch — pin batch size and disable auto-tune. Useful for
# load testing (=1 to stress hub at max rate), debugging (=1 to inspect every
# token), conservative production (=20 for predictable hub load), or
# pre-characterized fast clusters (=50). Time cap still honored.
# STREAM_BATCH_FIXED=20

# ── Rate limiting ────────────────────────────────────────────────────────────
# All values use the "N/period" format (e.g. "60/minute", "1000/hour").
# Limits are keyed per API key (inference/list endpoints), per node_id
# (heartbeat/task endpoints), or per client IP (login/register).

# Inference calls per API key (POST /v1/chat/completions, /v1/messages, /request_inference)
# RATE_LIMIT_INFERENCE=60/minute

# Model/node listing per API key (GET /v1/models, /nodes)
# RATE_LIMIT_LIST=120/minute

# Node registration per IP (POST /register)
# RATE_LIMIT_REGISTER=20/minute

# Dashboard login attempts per IP (POST /login)
# RATE_LIMIT_LOGIN=10/minute

# Heartbeat and task polling per node (POST /heartbeat, GET /tasks/pending, POST /tasks/complete)
# RATE_LIMIT_HEARTBEAT=30/minute

# Optional Redis backend for rate limit state (default: in-memory, lost on restart).
# Use this when running multiple hub instances behind a load balancer.
# RATE_LIMIT_STORAGE_URL=redis://localhost:6379

# ── Metrics retention ────────────────────────────────────────────────────────

# Days to retain per-inference event rows (default: 30)
METRICS_RETENTION_DAYS=30

# Days to retain node snapshot rows (default: 7)
SNAPSHOT_RETENTION_DAYS=7

# LLAMACPP_HOST=http://127.0.0.1:8080
# LLAMACPP_API_KEY=          # only if llama-server started with --api-key